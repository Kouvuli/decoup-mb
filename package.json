    "check": "npm run typecheck && npm run boundaries"
  },
  "dependencies": {
    "expo": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "dependency-cruiser": "17.4.3"
  }
}
