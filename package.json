{
  "name": "decoup-mb",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "engines": { "node": ">=22.13.0", "npm": ">=10" },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
