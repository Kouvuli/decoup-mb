{
  "name": "decoup-mb",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "check": "npm run typecheck && npm run boundaries",
    "test": "node --experimental-strip-types --test tests/*.test.mjs src/modules/identity/internal/*.test.mjs"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "dependency-cruiser": "17.4.3",
    "typescript": "~6.0.3"
  }
}
